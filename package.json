{
  "name": "@aaa147258qq/image-gen-mcp",
  "version": "1.0.0",
  "description": "MCP server that wraps a remote OpenAI-compatible image-generation API (/v1/images/generations and /v1/images/edits). Run with `npx -y @aaa147258qq/image-gen-mcp`.",
  "type": "module",
  "bin": {
    "image-gen-mcp": "bin/image-gen-mcp.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-generation",
    "image-editing",
    "ai",
    "openai-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YQT-api/image-gen-mcp.git"
  },
  "homepage": "https://github.com/aaa147258qq/image-gen-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
